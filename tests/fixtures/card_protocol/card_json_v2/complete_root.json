{
  "schema": "2.0",
  "config": {
    "streaming_mode": true,
    "streaming_config": {
      "print_frequency_ms": {"default": 70, "pc": 70},
      "print_strategy": "fast"
    },
    "summary": {
      "content": "Release health",
      "i18n_content": {"zh_cn": "发布健康度"}
    },
    "locales": ["en_us", "zh_cn"],
    "enable_forward": true,
    "update_multi": true,
    "width_mode": "fill",
    "use_custom_translation": true,
    "enable_forward_interaction": true,
    "style": {
      "text_size": {
        "title": {"default": "heading-2", "pc": "heading-2", "mobile": "heading-3"}
      },
      "color": {
        "cus-primary": {"light_mode": "rgba(30,120,255,1)", "dark_mode": "rgba(80,150,255,1)"}
      }
    }
  },
  "card_link": {
    "url": "https://example.com/release",
    "pc_url": "https://example.com/release/desktop"
  },
  "header": {
    "title": {"tag": "plain_text", "content": "Release health"},
    "subtitle": {"tag": "plain_text", "content": "All systems normal"},
    "template": "blue",
    "icon": {"tag": "standard_icon", "token": "approval_colorful"},
    "text_tag_list": [
      {"tag": "text_tag", "element_id": "status_tag", "text": {"tag": "plain_text", "content": "Stable"}, "color": "green"}
    ],
    "padding": "12px 12px 8px 12px"
  },
  "body": {
    "direction": "vertical",
    "padding": "12px",
    "horizontal_spacing": "medium",
    "vertical_spacing": "large",
    "horizontal_align": "left",
    "vertical_align": "top",
    "elements": [
      {"tag": "markdown", "element_id": "summary_md", "content": "**All checks are passing.**", "text_size": "title", "margin": "0px"},
      {
        "tag": "column_set",
        "element_id": "metrics_cols",
        "flex_mode": "none",
        "columns": [
          {"tag": "column", "width": "weighted", "weight": 1, "elements": [{"tag": "markdown", "element_id": "metric_one", "content": "Latency: 92ms"}]},
          {"tag": "column", "width": "weighted", "weight": 1, "elements": [{"tag": "markdown", "element_id": "metric_two", "content": "Errors: 0"}]}
        ]
      },
      {
        "tag": "form",
        "element_id": "feedback_form",
        "name": "feedback",
        "elements": [
          {"tag": "input", "element_id": "reason_input", "name": "reason", "required": true, "placeholder": {"tag": "plain_text", "content": "Reason"}},
          {"tag": "button", "element_id": "submit_button", "name": "submit", "form_action_type": "submit", "text": {"tag": "plain_text", "content": "Submit"}, "type": "primary_filled"}
        ]
      }
    ]
  }
}
