{
  "schema": "2.0",
  "config": {"update_multi": true},
  "body": {
    "elements": [
      {"tag": "select_static", "element_id": "severity", "name": "severity", "required": true, "placeholder": {"tag": "plain_text", "content": "Severity"}, "width": "100px", "disabled": false, "disabled_tips": {"tag": "plain_text", "content": "Locked"}, "hover_tips": {"tag": "plain_text", "content": "Choose severity"}, "behaviors": [{"type": "callback", "value": {"control": "severity"}}], "confirm": {"title": {"tag": "plain_text", "content": "Apply?"}, "text": {"tag": "plain_text", "content": "Update severity?"}}, "margin": "2px", "type": "text", "options": [{"text": {"tag": "plain_text", "content": "S1"}, "value": "s1", "icon": {"tag": "standard_icon", "token": "right_small"}}, {"text": {"tag": "plain_text", "content": "S2"}, "value": "s2"}], "initial_option": "s2", "initial_index": 1},
      {"tag": "multi_select_static", "name": "labels", "options": [{"text": {"tag": "plain_text", "content": "Backend"}, "value": "backend"}, {"text": {"tag": "plain_text", "content": "Urgent"}, "value": "urgent"}], "selected_values": ["backend", "urgent"], "type": "default"},
