      {"tag": "picker_time", "name": "due_time", "placeholder": {"tag": "plain_text", "content": "Due time"}, "initial_time": "09:30"},
      {"tag": "picker_datetime", "name": "release_at", "placeholder": {"tag": "plain_text", "content": "Release time"}, "initial_datetime": "2026-08-25 09:30"},
      {"tag": "select_img", "element_id": "cover", "name": "cover", "options": [{"img_key": "img_v2_a", "value": "cover_a", "disabled": false, "disabled_tips": {"tag": "plain_text", "content": "Unavailable"}, "hover_tips": {"tag": "plain_text", "content": "Select cover"}}], "multi_select": false, "layout": "trisect", "aspect_ratio": "16:9", "value": {"source": "cover_picker"}, "behaviors": [{"type": "callback", "value": {"control": "cover"}}]},
      {"tag": "checker", "element_id": "confirmed", "name": "confirmed", "checked": false, "text": {"tag": "lark_md", "content": "I **confirm** the release"}, "overall_checkable": true, "button_area": {"pc_display_rule": "on_hover", "buttons": [{"tag": "button", "text": {"tag": "plain_text", "content": "View runbook"}, "behaviors": [{"type": "open_url", "default_url": "https://example.com/runbook"}]}]}, "checked_style": {"show_strikethrough": true, "opacity": 0.5}, "padding": "-1px 4px", "behaviors": [{"type": "callback", "value": {"control": "confirmed"}}]},
      {"tag": "form", "name": "cover_form", "elements": [{"tag": "select_img", "name": "form_cover", "options": [{"img_key": "img_v2_form", "value": "cover_form"}], "can_preview": true, "behaviors": [{"type": "callback", "value": {"control": "form_cover"}}]}, {"tag": "button", "text": {"tag": "plain_text", "content": "Submit"}, "name": "submit_cover", "form_action_type": "submit"}]}
    ]
