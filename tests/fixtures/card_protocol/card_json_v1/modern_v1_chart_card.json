{
  "config": {
    "enable_forward": true,
    "update_multi": true,
    "width_mode": "fill",
    "use_custom_translation": true,
    "enable_forward_interaction": true,
    "style": {
      "text_size": {
        "cus-0": {
          "default": "medium",
          "pc": "medium",
          "mobile": "large"
        }
      },
      "color": {
        "cus-0": {
          "light_mode": "rgba(5,157,178,0.52)",
          "dark_mode": "rgba(78,23,108,0.49)"
        }
      }
    }
  },
  "card_link": {
    "url": "https://example.com/card",
    "pc_url": "https://example.com/desktop-card"
  },
  "header": {
    "title": {
      "tag": "plain_text",
      "content": "Release health",
      "i18n": {
        "en_us": "Release health",
        "zh_cn": "发布健康度"
      }
    },
    "subtitle": {
      "tag": "plain_text",
      "content": "Current deployment"
    },
    "template": "wathet",
    "icon": {
      "tag": "standard_icon",
      "token": "approval_colorful",
      "color": "blue"
    },
    "text_tag_list": [
      {
        "tag": "text_tag",
        "text": {
          "tag": "plain_text",
          "content": "Stable"
        },
        "color": "green"
      }
    ]
  },
  "elements": [
    {
      "tag": "div",
      "text": {
        "tag": "plain_text",
        "content": "All checks are passing.",
        "i18n_content": {
          "zh_cn": "所有检查均已通过。"
        }
      }
    },
    {
      "tag": "markdown",
      "content": "**Traffic is stable**"
    },
    {
      "tag": "hr"
    },
    {
      "tag": "img",
      "img_key": "img_release_health",
      "alt": {
        "tag": "plain_text",
        "content": "Release graph"
      },
      "i18n_img_key": {
        "zh_cn": "img_release_health_zh"
      },
      "scale_type": "crop_top"
    },
    {
      "tag": "chart",
      "chart_spec": {
        "type": "line",
        "data": {
          "values": [
            {"time": "09:00", "value": 92},
            {"time": "10:00", "value": 97}
          ]
        },
        "xField": "time",
        "yField": "value"
      },
      "aspect_ratio": "16:9",
      "color_theme": "brand",
      "preview": true,
      "height": "320px"
    }
  ],
  "i18n_elements": {
    "zh_cn": [
      {
        "tag": "markdown",
        "content": "**流量稳定**"
      }
    ]
  },
  "fallback": {
    "trigger_conditions": [
      {
        "type": "min_client_version",
        "value": "v7.9"
      },
      {
        "type": "element_tags",
        "value": ["chart", "table"]
      }
    ]
  }
}
